# SahanaMart Environment Configuration Template
# Copy this file to .env or set environment variables

# Server Port
PORT=8080

# Database Configuration (Defaults to embedded H2 file database)
DB_DRIVER=org.h2.Driver
DB_URL=jdbc:h2:file:./data/sahanamart;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE;MODE=MySQL
DB_USERNAME=sa
DB_PASSWORD=

# Session Security
SESSION_TIMEOUT_MINUTES=30

# AI Chatbot Configuration
# Provider options: mock | gemini
AI_CHATBOT_PROVIDER=mock
AI_CHATBOT_RATE_LIMIT_PER_MINUTE=10
AI_CHATBOT_MAX_INPUT_LENGTH=250

# Optional Google Gemini API Key (Required only if AI_CHATBOT_PROVIDER=gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
